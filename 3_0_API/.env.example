# =============================================================================
# .env.example — Plantilla de variables de entorno
# Copia este archivo como .env y rellena los valores reales
# NUNCA subas el archivo .env al repositorio Git
# =============================================================================

# Base de datos MySQL
MYSQL_USER=root
MYSQL_PASSWORD=TU_CONTRASENA_AQUI
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=Kimuka3_db

# Clave secreta para JWT (genera una con: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA

# Modo debug: "true" solo en desarrollo local, NUNCA en produccion
FLASK_DEBUG=false
