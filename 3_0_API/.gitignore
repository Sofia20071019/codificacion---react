# =============================================================================
# .gitignore — API Kimuka Flask
# Archivos y carpetas que NO deben subirse al repositorio Git
# =============================================================================

# Variables de entorno (contiene credenciales y secretos)
.env
.env.*
!.env.example

# Entorno virtual Python
venv/
env/
.venv/

# Cache de Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Covertura de tests
.coverage
htmlcov/
.pytest_cache/

# Archivos de base de datos locales
*.db
*.sqlite3

# Uploads de archivos (imagenes, etc.)
app/uploads/

# Archivos comprimidos
*.rar
*.zip

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db

# Migraciones generadas localmente (conserva la carpeta pero no los .pyc)
migrations/__pycache__/

# Logs
*.log
